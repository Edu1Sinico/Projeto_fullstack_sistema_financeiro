APP_NAME="Sistema Financeiro - Testes"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Use obrigatoriamente um banco exclusivo para testes.
# A suíte recria as tabelas durante a execução.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_financeiro_testing
DB_USERNAME=mysql
DB_PASSWORD=

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

JWT_SECRET=test-secret-with-at-least-thirty-two-characters
JWT_TTL=120

MAIL_MAILER=array
