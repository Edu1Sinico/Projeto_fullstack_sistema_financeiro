<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/finaxis_white">

    <!-- Cabeçalho -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/finaxis_dark">

        <TextView
            android:id="@+id/txtPageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Finaxis"
            android:textColor="@color/finaxis_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mais opções"
            android:src="@android:drawable/ic_menu_more"
            android:tint="@color/finaxis_white" />

    </LinearLayout>

    <!-- Conteúdo dos Fragments -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Navegação inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/finaxis_dark">

        <TextView
            android:id="@+id/navDashboard"
            style="@style/FinaxisNavItem"
            android:text="Início" />

        <TextView
            android:id="@+id/navTransactions"
            style="@style/FinaxisNavItem"
            android:text="Transações" />

        <TextView
            android:id="@+id/navAccounts"
            style="@style/FinaxisNavItem"
            android:text="Contas" />

        <TextView
            android:id="@+id/navGoals"
            style="@style/FinaxisNavItem"
            android:text="Metas" />

    </LinearLayout>

</LinearLayout>
