APP_NAME=Finaxis
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/sistema_financeiro
APP_BASE_PATH=/sistema_financeiro
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_financeiro
DB_USERNAME=root
DB_PASSWORD=
# Banco na nuvem (TiDB Cloud): DB_SSL=true. No XAMPP deixe false.
DB_SSL=false

# Troque por uma sequência aleatória com no mínimo 32 caracteres.
JWT_SECRET=troque-esta-chave-por-uma-sequencia-segura-com-64-caracteres
JWT_TTL=120

# O asterisco facilita os testes do aplicativo Android durante o desenvolvimento.
CORS_ALLOWED_ORIGIN=*
COOKIE_SECURE=false
